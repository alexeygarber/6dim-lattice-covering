# This is our target form Q6c
Q6 = [[E6[i][j]+x*R2[i][j]+y*R3[i][j]+z*R4[i][j] for i in range(6)] for j in range(6)]

Q6_det = matrix(Q6).determinant()

print("Quadratic form Q6c:")
