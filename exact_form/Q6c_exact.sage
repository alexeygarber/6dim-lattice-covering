for simplex in MAX_SIMPLICES:
    free_sum = FREE_SUMS[simplex["free_sum"]]
    
    # First checking that simplex is in designated free sum
    for j in free_sum["triangles"][0]:
        if j not in simplex["vertices"]:
            raise ValueError("Incorrect vertices")
    tmp = 0
    for j in free_sum["triangles"][1]:
        if j not in simplex["vertices"]:
            tmp +=1
    if tmp!=1:
        raise ValueError("Incorrect vertices")
    tmp = 0
    for j in free_sum["triangles"][2]:
        if j not in simplex["vertices"]:
            tmp +=1
    if tmp!=1:
        raise ValueError("Incorrect vertices")
     
    # finding its circumradius and checking it is maximal
    new=simplex["vertices"]
    
    vectors = [vector(j)-vector(new[0]) for j in new[1:]]
    tmp_mat = [[0 for _ in range(7)] for _ in range(7)]
    
    for j in range(6):
        tmp_mat[0][j+1]=sum(vectors[j][m]*Q6[m][l]*vectors[j][l] for m in range(6) for l in range(6))
        tmp_mat[j+1][0]=tmp_mat[0][j+1]
        for k in range(6):
            tmp_mat[j+1][k+1]=sum(vectors[j][m]*Q6[m][l]*vectors[k][l] for m in range(6) for l in range(6))
    

    tmp2 = -(matrix(tmp_mat).determinant())
    if tmp2!=max_radius:
        raise ValueError("Incorrect circumradius")
        
print("All simplices checked. Max circumradius confirmed\n")
print("Time:", (datetime.now()-total_start).total_seconds(),"seconds\n")



print("Starting certification\n")

