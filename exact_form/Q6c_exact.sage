]

n = len(FREE_SUMS)

for i in range(n):
    # Checking that centers are not translations or central symmetries w.r.t. integer lattice
    for j in range(i+1,n):
        if (vector(QQ,FREE_SUMS[i]["center"])-vector(QQ,FREE_SUMS[j]["center"])).denominator()==1 or (vector(QQ,FREE_SUMS[i]["center"])+vector(QQ,FREE_SUMS[j]["center"])).denominator()==1:
            raise ValueError("Incorrect free sums")
    # Checking that each triangle has prescribed center
    for tr in FREE_SUMS[i]["triangles"]:
        if sum(vector(ZZ,j) for j in tr)!=3*vector(QQ,FREE_SUMS[i]["center"]):
            raise ValueError("Incorrect triangles")
    
    # Checking correct volume
    cur_pts = [j for tr in FREE_SUMS[i]["triangles"] for j in tr]
    tmp_poly = Polyhedron(vertices=cur_pts)
    if tmp_poly.volume()!=9/720 or len(tmp_poly.vertices())!=9:
        raise ValueError("Incorrect free sums")
        
    # Checking radius w.r.t. E6
    
    center = FREE_SUMS[i]["center"]
    for vert in cur_pts:
        tmp_vec = [vert[j]-center[j] for j in range(6)]
        if sum(tmp_vec[k]*E6[k][j]*tmp_vec[j] for k in range(6) for j in range(6))!=2:
            raise ValueError("Incorrect radius")


    # Checking that triangles are orthogonal w.r.t. E6
    for m in range(3):
        tmp_vec10 = [FREE_SUMS[i]["triangles"][m][0][j]-center[j] for j in range(6)]
        tmp_vec11 = [FREE_SUMS[i]["triangles"][m][1][j]-center[j] for j in range(6)]
        for l in range(m+1,3):
            tmp_vec20 = [FREE_SUMS[i]["triangles"][l][0][j]-center[j] for j in range(6)]
            tmp_vec21 = [FREE_SUMS[i]["triangles"][l][1][j]-center[j] for j in range(6)]
            if sum(tmp_vec10[k]*E6[k][j]*tmp_vec20[j] for k in range(6) for j in range(6))!=0:
                raise ValueError("Triangles of free sums must be orthogonal")
            if sum(tmp_vec11[k]*E6[k][j]*tmp_vec20[j] for k in range(6) for j in range(6))!=0:
                raise ValueError("Triangles of free sums must be orthogonal")
            if sum(tmp_vec10[k]*E6[k][j]*tmp_vec21[j] for k in range(6) for j in range(6))!=0:
                raise ValueError("Triangles of free sums must be orthogonal")
            if sum(tmp_vec11[k]*E6[k][j]*tmp_vec21[j] for k in range(6) for j in range(6))!=0:
                raise ValueError("Triangles of free sums must be orthogonal")

    # Checking that E6*center is an integer vector. This is enough to check empty sphere condition
    # E6[x-c]=E6[c]+E6[x]-2x^tE6c is an even integer so it can't be less than 2
    if (matrix(E6)*vector(center)).denominator() != 1:
        raise ValueError("E6*center must be an integer vector")
    if ((matrix(center))*(matrix(E6)*matrix(center).transpose())/2).denominator() != 1:
        raise ValueError("E6[center] must be an integer vector")
print("Free sum check done!\n")
print("Time:", (datetime.now()-total_start).total_seconds(),"seconds\n")

# Checking local Delaunay property for each free sum
# The first triangle is present in all simplices of the triangulation

print("Checking local Delaunay property for each free sum and finding maximal circumradius")

n = len(FREE_SUMS)

max_radius = 0

count = 0 

for i in range(n):
    tmp = FREE_SUMS[i]["triangles"]
    simplices = [
        {tmp[0][0],tmp[0][1],tmp[0][2],tmp[1][mod(i+1,3)],tmp[1][mod(i+2,3)],tmp[2][mod(j+1,3)],tmp[2][mod(j+2,3)]} for i in range(3) for j in range(3)
    ]
    if len(simplices)!=9:
        raise ValueError("Incorrect free sums")
    for j in range(9):
        for k in range(j+1,9):
            if len(simplices[j].intersection(simplices[k]))==6:
                facet = list(simplices[j].intersection(simplices[k]))
                new = list(simplices[j].symmetric_difference(simplices[k]))
                # Solving for unique affine dependency
                coef = matrix([list(f)+[1] for f in facet]).solve_left(vector(list(vector(new[0])+vector(new[1]))+[2]))
                
                left = sum(new[0][j]*Q6[j][k]*new[0][k] for j in range(6) for k in range(6))+sum(new[1][j]*Q6[j][k]*new[1][k] for j in range(6) for k in range(6))
                right = sum(coef[m]*sum(facet[m][j]*Q6[j][k]*facet[m][k] for j in range(6) for k in range(6)) for m in range(6))
                if left <= right:
                    raise ValueError("This is not Delaunay triangulation")
    
    simplices = [list(j) for j in simplices]
    
    for new in simplices:
        vectors = [vector(j)-vector(new[0]) for j in new[1:]]
        tmp_mat = [[0 for _ in range(7)] for _ in range(7)]
    
        for j in range(6):
            tmp_mat[0][j+1]=sum(vectors[j][m]*Q6[m][l]*vectors[j][l] for m in range(6) for l in range(6))
            tmp_mat[j+1][0]=tmp_mat[0][j+1]
            for k in range(6):
                tmp_mat[j+1][k+1]=sum(vectors[j][m]*Q6[m][l]*vectors[k][l] for m in range(6) for l in range(6))
    

        tmp2 = -(matrix(tmp_mat).determinant())
    
    
        if tmp2>max_radius:
            max_radius=tmp2
            count = 1
        elif tmp2 == max_radius:
            count += 1
        

print("Delaunay property checked!\n")

if max_radius/(4*Q6_det)!=mu:
    raise ValueError("Max radius squared is not mu")

print("Max squared radius confirmed:",mu)
print("Simplex classes with this radius:",count,"\n")
print("Time:", (datetime.now()-total_start).total_seconds(),"seconds\n")


print("Checking maximal simplices")

