cert_matrices = [
    matrix([[sum(orbit[j][k][0][i]*x^i for i in range(len(orbit[j][k][0])))/orbit[j][k][1]
      for k in range(7)
     ] for j in range(7)
    ])
    for orbit in ZCERT
] 

for mat in cert_matrices:
    if mat.rank()!=1 or mat.trace()<=0 or (not mat.is_symmetric()):
        raise ValueError("Unexpected matrix certificates")
    
N_MAT=[-(2*diagonal_matrix([mat[0][j+1] for j in range(6)])+mat.delete_rows([0]).delete_columns([0])) for mat in cert_matrices]

for simplex in MAX_SIMPLICES:
    v_mat = matrix([vector(simplex['vertices'][j])-vector(simplex['vertices'][0]) for j in range(1,7)]).transpose()
    
    RHS += 4*cert_matrices[simplex['orbit']][0][0]
    
    LHS += v_mat * N_MAT[simplex['orbit']] * v_mat.transpose()

if not (LHS.is_positive_definite() and RHS>0):
    raise ValueError("Given data fails to certify an upper bound")
    
upper_bound = (mu^6*RHS^6)/(6^6*LHS.determinant())

print("Certified determinant upper bound using simplices with maximal circumradii:", upper_bound, "\n")

if upper_bound == Q6_det:
    print("Certification successful! The upper bound coincides with properly scaled det(Q6c)")
else:
    raise ValueError("Certification is not successful")
    
theta = (mu^3/sqrt(Q6_det))*pi^3/6    
print("Covering density of Q6c:",N(theta))


print("Total time:", (datetime.now()-total_start).total_seconds(),"seconds")